<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AIMediaWorker.Views.LocalMediaBrowserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="BreadcrumbNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
    </UserControl.Resources>
    <Grid Padding="10,8,10,10" RowSpacing="8" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <CommandBar Style="{StaticResource RightPanelCommandBarStyle}">
            <AppBarButton x:Uid="BrowserChooseFolder" Style="{StaticResource RightPanelAppBarButtonStyle}" ToolTipService.ToolTip="{Binding Label, RelativeSource={RelativeSource Self}}" Icon="Folder" Label="Choose folder" Click="OnChooseFolderClick" />
            <AppBarButton x:Uid="BrowserHome" Style="{StaticResource RightPanelAppBarButtonStyle}" ToolTipService.ToolTip="{Binding Label, RelativeSource={RelativeSource Self}}" Icon="Home" Label="Home folder" Click="OnHomeClick" />
            <AppBarButton x:Uid="BrowserParentFolder" Style="{StaticResource RightPanelAppBarButtonStyle}" ToolTipService.ToolTip="{Binding Label, RelativeSource={RelativeSource Self}}" Icon="Back" Label="Parent folder" Click="OnParentClick" />
            <AppBarButton x:Uid="BrowserRefresh" Style="{StaticResource RightPanelAppBarButtonStyle}" ToolTipService.ToolTip="{Binding Label, RelativeSource={RelativeSource Self}}" Icon="Refresh" Label="Refresh" Click="OnRefreshClick" />
            <AppBarButton x:Uid="BrowserSort" x:Name="SortButton" Style="{StaticResource RightPanelAppBarButtonStyle}" ToolTipService.ToolTip="{Binding Label, RelativeSource={RelativeSource Self}}" Label="Sort by name" Click="OnSortClick">
                <AppBarButton.Icon><FontIcon x:Name="SortIcon" Glyph="&#xE8CB;" /></AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>
        <Grid x:Name="BreadcrumbHost" Grid.Row="1" SizeChanged="OnBreadcrumbSizeChanged">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button x:Name="BreadcrumbOverflowButton" Style="{StaticResource BreadcrumbNavigationButtonStyle}" Content="..." Margin="0,0,2,0" Visibility="Collapsed" />
            <StackPanel x:Name="BreadcrumbItems" Grid.Column="1" Orientation="Horizontal" Spacing="2" />
        </Grid>
        <StackPanel Grid.Row="2" Spacing="4">
            <Grid ColumnSpacing="8" RowSpacing="4">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <SymbolIcon Symbol="Find" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource RightPanelMutedTextBrush}" IsHitTestVisible="False" />
                <TextBox x:Uid="BrowserSearch" x:Name="SearchBox" Grid.Column="1" Style="{StaticResource RightPanelTextBoxStyle}" PlaceholderText="Search subfolders" TextChanged="OnSearchTextChanged" KeyDown="OnSearchKeyDown" />
                <ToggleButton x:Uid="BrowserRegexSearch" x:Name="RegexSearchToggle" Grid.Column="2" MinWidth="38" Height="36" Padding="8,0" CornerRadius="6" Content=".*" Click="OnRegexSearchClick" />
                <Button x:Uid="BrowserSearchButton" x:Name="SearchButton" Grid.Column="3" ToolTipService.ToolTip="{Binding Content, RelativeSource={RelativeSource Self}}" Style="{StaticResource RightPanelButtonStyle}" Content="Search" Click="OnSearchClick" />
                <ProgressRing x:Name="SearchProgressRing" Grid.Row="1" Width="16" Height="16" IsActive="False" />
                <TextBlock x:Name="SearchStatusText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource RightPanelMutedTextBrush}" FontSize="11" />
            </Grid>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <SymbolIcon Symbol="Filter" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource RightPanelMutedTextBrush}" IsHitTestVisible="False" />
                <TextBox x:Uid="BrowserFilter" x:Name="FilterBox" Grid.Column="1" Style="{StaticResource RightPanelTextBoxStyle}" PlaceholderText="Filter by name" TextChanged="OnFilterTextChanged" />
            </Grid>
        </StackPanel>
        <ListView x:Name="EntryList" Grid.Row="3" Style="{StaticResource RightPanelListStyle}" ItemContainerStyle="{StaticResource RightPanelListItemStyle}" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnEntryClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="2,0" ColumnSpacing="10" RightTapped="OnEntryRightTapped">
                        <Grid.ContextFlyout><MenuFlyout><MenuFlyoutItem x:Uid="AddBrowserFavorite" Text="Add to favorites" Click="OnAddFavoriteClick" /></MenuFlyout></Grid.ContextFlyout>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="{Binding IconGlyph}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding DisplayName}" />
                        <TextBlock Grid.Column="2" Text="{Binding Details}" FontSize="12" Foreground="{ThemeResource RightPanelMutedTextBrush}" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
