<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AIMediaWorker.Views.ScreenRecordingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Screen recording">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="RootGrid" Padding="20" RowSpacing="14" Loaded="OnLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Uid="ScreenRecordingHeading" Text="Record a window or a selected region" FontSize="24" FontWeight="SemiBold" />

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock x:Uid="CaptureTargetLabel" Text="Capture target" VerticalAlignment="Center" />
            <ComboBox x:Name="CaptureModeCombo" Grid.Column="1" SelectionChanged="OnCaptureModeChanged" HorizontalAlignment="Stretch">
                <ComboBoxItem x:Uid="CaptureWindowMode" Content="Window" Tag="Window" />
                <ComboBoxItem x:Uid="CaptureRegionMode" Content="Selected region" Tag="Region" />
            </ComboBox>
        </Grid>

        <Grid x:Name="WindowTargetPanel" Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Uid="WindowToRecordLabel" Text="Window" VerticalAlignment="Center" />
            <ComboBox x:Name="WindowCombo" Grid.Column="1" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" />
            <Button x:Uid="RefreshWindowsButton" Grid.Column="2" Content="Refresh" Click="OnRefreshWindowsClick" />
        </Grid>

        <Grid x:Name="RegionTargetPanel" Grid.Row="2" ColumnSpacing="8" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Uid="RegionToRecordLabel" Text="Region" VerticalAlignment="Center" />
            <TextBlock x:Name="RegionText" Grid.Column="1" VerticalAlignment="Center" Opacity="0.8" />
            <Button x:Uid="SelectRegionButton" Grid.Column="2" Content="Select region…" Click="OnSelectRegionClick" />
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock x:Uid="FrameRateLabel" Text="Frame rate" VerticalAlignment="Center" />
            <NumberBox x:Name="FrameRateBox" Grid.Column="1" Minimum="10" Maximum="60" SmallChange="5" SpinButtonPlacementMode="Inline" Value="30" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE767;" FontSize="16" />
                <TextBlock x:Uid="SystemAudioIncludedText" Text="System audio will be included" />
            </StackPanel>
        </Grid>

        <InfoBar x:Name="StatusBar" Grid.Row="4" IsOpen="True" IsClosable="False" Severity="Informational" Title="Ready" Message="Select a target and start recording." />

        <Border Grid.Row="5" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="18">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <FontIcon x:Name="RecordingIcon" Glyph="&#xE7C8;" FontSize="44" Opacity="0.7" />
                <TextBlock x:Name="RecordingTimeText" Text="00:00:00" FontFamily="Consolas" FontSize="26" HorizontalAlignment="Center" />
                <TextBlock x:Uid="RecordingHintText" Text="The recording is finalized as MP4 when you stop." Opacity="0.65" TextAlignment="Center" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Uid="StartScreenRecordingButton" x:Name="StartButton" Content="Start recording" Click="OnStartClick" Style="{StaticResource AccentButtonStyle}" />
            <Button x:Uid="StopScreenRecordingButton" x:Name="StopButton" Content="Stop and save" Click="OnStopClick" IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
