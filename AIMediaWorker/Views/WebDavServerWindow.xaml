<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AIMediaWorker.Views.WebDavServerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add WebDAV server">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="Root" Padding="24" RowSpacing="16" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="SemiBold" />
        <TextBox x:Name="NameBox" Grid.Row="1" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
        <TextBox x:Name="AddressBox" Grid.Row="2" PlaceholderText="server.example/dav/" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
        <NumberBox x:Name="PortBox" Grid.Row="3" Value="443" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Hidden" />
        <TextBox x:Name="UsernameBox" Grid.Row="4" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
        <PasswordBox x:Name="PasswordBox" Grid.Row="5" />
        <InfoBar x:Name="ValidationBar" Grid.Row="6" IsOpen="False" IsClosable="False" Severity="Error" VerticalAlignment="Top" />

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CancelButton" Click="OnCancelClick" />
            <Button x:Name="SaveButton" Style="{ThemeResource AccentButtonStyle}" Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
