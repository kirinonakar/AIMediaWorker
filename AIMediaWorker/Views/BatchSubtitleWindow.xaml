<Window
    x:Class="AIMediaWorker.Views.BatchSubtitleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          Padding="24" RowSpacing="14" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="0" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Spacing="14">
            <TextBlock x:Uid="BatchHeading" Text="Batch subtitles" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Uid="BatchDescription" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                       ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                       Text="Add video or audio files, or drop them here. SRT files are saved beside each media file. Existing files are kept with numbered names." />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Button x:Uid="BatchAdd" x:Name="AddButton" Content="Add files…" Click="OnAddClick" />
                <Button x:Uid="BatchClear" x:Name="ClearButton" Grid.Column="1" Content="Clear list" Click="OnClearClick" />
                <TextBlock x:Name="CountText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>
        <Border Grid.Row="1" MinHeight="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
            <ListView x:Name="FileList" MinHeight="0" SelectionMode="None" ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="4,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Path}" />
                                <TextBlock Text="{Binding Path}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Opacity="0.7" FontSize="12" />
                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <TextBlock Text="{Binding Outputs}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" />
                            </StackPanel>
                            <Button x:Uid="BatchRemove" Grid.Column="1" Content="Remove" VerticalAlignment="Top"
                                    IsEnabled="{Binding CanRemove}" Click="OnRemoveClick" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
        <StackPanel Grid.Row="2" Spacing="14" VerticalAlignment="Bottom">
            <StackPanel Spacing="6">
                <CheckBox x:Uid="BatchTranslate" x:Name="TranslateCheckBox" Content="Also save translated subtitles" />
                <TextBlock x:Name="TranslationText" TextTrimming="CharacterEllipsis" Opacity="0.7"
                           ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <TextBlock x:Uid="BatchOutputHint" TextTrimming="CharacterEllipsis" Opacity="0.7" FontSize="12"
                           ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           Text="Original: filename.srt · Translation: filename.translated.srt" />
            </StackPanel>
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.ColumnSpan="3" TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <ProgressBar x:Name="Progress" Grid.Row="1" VerticalAlignment="Center" />
                <Button x:Uid="BatchStart" x:Name="StartButton" Grid.Row="1" Grid.Column="1" Content="Start" Click="OnStartClick" Style="{StaticResource AccentButtonStyle}" />
                <Button x:Uid="BatchCancel" x:Name="CancelButton" Grid.Row="1" Grid.Column="2" Content="Cancel" IsEnabled="False" Click="OnCancelClick" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
