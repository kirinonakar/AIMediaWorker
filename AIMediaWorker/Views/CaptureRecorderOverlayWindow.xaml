<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AIMediaWorker.Views.CaptureRecorderOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Capture &amp; record">
    <Window.SystemBackdrop><DesktopAcrylicBackdrop /></Window.SystemBackdrop>
    <StackPanel x:Name="Root" MinWidth="340" Spacing="1" Loaded="OnLoaded" SizeChanged="OnContentSizeChanged" KeyDown="OnRootKeyDown">
        <Grid x:Name="ToolbarPanel" ColumnSpacing="7" Margin="8,5,8,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border x:Name="DragHandle"
                    Grid.Column="0"
                    Width="22"
                    Background="Transparent"
                    CornerRadius="5"
                    PointerPressed="OnDragHandlePointerPressed"
                    PointerMoved="OnDragHandlePointerMoved"
                    PointerReleased="OnDragHandlePointerReleased"
                    PointerCaptureLost="OnDragHandlePointerCaptureLost">
                <TextBlock Text="⋮⋮"
                           FontSize="16"
                           Opacity="0.55"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <Border Grid.Column="1"
                    Padding="2"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="7">
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <ToggleButton x:Name="CaptureModeButton" Width="30" Height="30" Padding="0" Click="OnCaptureModeClick">
                        <FontIcon Glyph="&#xE722;" FontSize="14" />
                    </ToggleButton>
                    <ToggleButton x:Name="RecordModeButton" Width="30" Height="30" Padding="0" Click="OnRecordModeClick">
                        <FontIcon Glyph="&#xE714;" FontSize="14" />
                    </ToggleButton>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    HorizontalAlignment="Center"
                    Padding="2"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="7">
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <Button x:Name="FullscreenButton" Width="30" Height="30" Padding="0" Click="OnFullscreenClick">
                        <FontIcon Glyph="&#xE740;" FontSize="14" />
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <Button x:Name="WindowAreaButton" Width="30" Height="30" Padding="0" Click="OnWindowAreaClick">
                            <FontIcon Glyph="&#xE737;" FontSize="14" />
                        </Button>
                        <ToggleButton x:Name="ScrollCaptureButton" Width="30" Height="30" Padding="0">
                            <TextBlock Text="↕" FontSize="15" FontWeight="SemiBold" />
                        </ToggleButton>
                    </StackPanel>
                    <Button x:Name="RegionButton" Width="30" Height="30" Padding="0" Click="OnRegionClick">
                        <FontIcon Glyph="&#xE7A8;" FontSize="14" />
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="3" Margin="8,0,0,0">
                        <Button x:Name="OcrButton" Width="30" Height="30" Padding="0" Click="OnOcrClick">
                            <FontIcon Glyph="&#xE721;" FontSize="14" />
                        </Button>
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <ToggleButton x:Name="TranslateOcrButton" Width="30" Height="30" Padding="0" Click="OnTranslateOcrClick">
                                <FontIcon Glyph="&#xE8C1;" FontSize="14" />
                            </ToggleButton>
                            <ToggleButton x:Name="VlmOcrButton" Width="38" Height="30" Padding="0" Click="OnVlmOcrClick">
                                <TextBlock Text="VLM" FontSize="10" FontWeight="SemiBold" />
                            </ToggleButton>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button Grid.Column="3" x:Name="CloseOverlayButton" Width="30" Height="30" Padding="0" Click="OnCloseClick">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8BB;" FontSize="14" />
            </Button>
        </Grid>
        <StackPanel x:Name="RecordingPanel" Orientation="Horizontal" Spacing="8" Margin="8,5,8,1" Visibility="Collapsed">
            <Border Width="22"
                    Height="32"
                    Background="Transparent"
                    CornerRadius="5"
                    PointerPressed="OnDragHandlePointerPressed"
                    PointerMoved="OnDragHandlePointerMoved"
                    PointerReleased="OnDragHandlePointerReleased"
                    PointerCaptureLost="OnDragHandlePointerCaptureLost">
                <TextBlock Text="⋮⋮"
                           FontSize="16"
                           Opacity="0.55"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <Ellipse Width="12" Height="12" Fill="#FFC42B1C" VerticalAlignment="Center" />
            <TextBlock x:Name="RecordingElapsedText" FontFamily="Consolas" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="66" Text="00:00" />
            <Button x:Name="PauseResumeButton" Width="30" Height="30" Padding="0" Click="OnPauseResumeClick">
                <FontIcon x:Name="PauseResumeIcon" Glyph="&#xE769;" FontSize="14" />
            </Button>
            <Button x:Name="StopRecordButton" Width="30" Height="30" Padding="0" Style="{ThemeResource AccentButtonStyle}" Click="OnStopRecordClick">
                <FontIcon Glyph="&#xE71A;" FontSize="14" />
            </Button>
        </StackPanel>
        <TextBlock x:Name="StatusText" FontSize="11" Opacity="0.75" Margin="12,0,12,6" MaxLines="1" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
        <Canvas Height="0">
            <Button x:Name="FocusSink" Width="1" Height="1" Opacity="0" IsTabStop="True" />
        </Canvas>
    </StackPanel>
</Window>
