<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AIMediaWorker.Views.CaptureRecorderOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Capture &amp; record">
    <Window.SystemBackdrop><DesktopAcrylicBackdrop /></Window.SystemBackdrop>
    <StackPanel x:Name="Root" Spacing="2" Loaded="OnLoaded" SizeChanged="OnContentSizeChanged">
        <StackPanel x:Name="ToolbarPanel" Orientation="Horizontal" Spacing="5" Margin="10,7,10,2">
            <Button x:Name="ModeToggleButton" MinWidth="76" Height="32" Click="OnModeToggleClick" />
            <Button x:Name="FullscreenButton" MinWidth="88" Height="32" Style="{ThemeResource AccentButtonStyle}" Click="OnFullscreenClick" />
            <Button x:Name="WindowAreaButton" MinWidth="70" Height="32" Click="OnWindowAreaClick" />
            <Button x:Name="RegionButton" MinWidth="70" Height="32" Click="OnRegionClick" />
            <Button x:Name="OcrButton" MinWidth="58" Height="32" Click="OnOcrClick" />
            <Button x:Name="CloseOverlayButton" Width="38" Height="32" Click="OnCloseClick">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8BB;" FontSize="14" />
            </Button>
        </StackPanel>
        <StackPanel x:Name="RecordingPanel" Orientation="Horizontal" Spacing="12" Margin="12,7,12,2" Visibility="Collapsed">
            <Ellipse Width="12" Height="12" Fill="#FFC42B1C" VerticalAlignment="Center" />
            <TextBlock x:Name="RecordingElapsedText" FontFamily="Consolas" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="66" Text="00:00" />
            <Button x:Name="PauseResumeButton" MinWidth="92" Height="32" Click="OnPauseResumeClick" />
            <Button x:Name="StopRecordButton" MinWidth="70" Height="32" Style="{ThemeResource AccentButtonStyle}" Click="OnStopRecordClick" />
        </StackPanel>
        <TextBlock x:Name="StatusText" FontSize="11" Opacity="0.75" Margin="12,0,12,6" MaxLines="1" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
        <Canvas Height="0">
            <Button x:Name="FocusSink" Width="1" Height="1" Opacity="0" IsTabStop="True" />
        </Canvas>
    </StackPanel>
</Window>
