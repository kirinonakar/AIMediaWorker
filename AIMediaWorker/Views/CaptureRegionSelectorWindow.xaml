<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AIMediaWorker.Views.CaptureRegionSelectorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Select area">
    <Grid x:Name="Root" Background="#33000000"
          PointerPressed="OnRootPointerPressed" PointerMoved="OnRootPointerMoved"
          PointerReleased="OnRootPointerReleased">
        <Canvas>
            <Rectangle x:Name="HoverHighlight" Stroke="#FF60CDFF" StrokeThickness="2" Fill="#220078D4" Visibility="Collapsed" />
            <Rectangle x:Name="SelectionBand" Stroke="#FFFFFFFF" StrokeThickness="2" Fill="#200078D4" Visibility="Collapsed" />
        </Canvas>
        <Border x:Name="HintBorder" CornerRadius="8" Background="#E61F1F1F" Padding="14,8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0">
            <TextBlock x:Name="HintText" Foreground="#FFFFFFFF" FontSize="13" />
        </Border>
        <Button x:Name="FocusSink" Width="1" Height="1" Opacity="0" IsTabStop="True" KeyDown="OnFocusSinkKeyDown" />
    </Grid>
</Window>
