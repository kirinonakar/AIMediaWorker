<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AIMediaWorker.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Preferences">
    <Grid x:Name="Root" Padding="16" RowSpacing="12" Loaded="OnLoaded">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer><StackPanel Spacing="12">
            <TextBlock x:Uid="PreferencesTitle" Text="Preferences" Style="{StaticResource TitleTextBlockStyle}" />
            <Expander x:Uid="GeneralExpander" Header="General" IsExpanded="True"><Grid Padding="8" ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock x:Uid="LanguageSetting" Text="Language" VerticalAlignment="Center" /><ComboBox x:Name="LanguageCombo" Grid.Column="1" ItemsSource="{x:Bind Languages}" />
                <TextBlock x:Uid="ThemeSetting" Grid.Row="1" Text="Theme" VerticalAlignment="Center" /><ComboBox x:Name="ThemeCombo" Grid.Row="1" Grid.Column="1" ItemsSource="{x:Bind Themes}" />
                <TextBlock x:Uid="RecentItemsSetting" Grid.Row="2" Text="Recent items" VerticalAlignment="Center" /><NumberBox x:Name="RecentCountBox" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="100" SpinButtonPlacementMode="Inline" />
                <CheckBox x:Uid="ResumeSetting" x:Name="ResumeCheck" Grid.Row="3" Grid.Column="1" Content="Resume playback position" />
            </Grid></Expander>
            <Expander x:Uid="PlaybackExpander" Header="Playback"><Grid Padding="8" ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock x:Uid="HardwareDecoderSetting" Text="Hardware decoder" VerticalAlignment="Center" /><ComboBox x:Name="HardwareCombo" Grid.Column="1" ItemsSource="{x:Bind HardwareDecoders}" />
                <TextBlock x:Uid="RtxSetting" Grid.Row="1" Text="RTX Video Super Resolution" VerticalAlignment="Center" /><ComboBox x:Name="RtxCombo" Grid.Row="1" Grid.Column="1" ItemsSource="{x:Bind RtxModes}" />
                <TextBlock x:Uid="RtxQualitySetting" Grid.Row="2" Text="RTX quality (0 = Auto)" VerticalAlignment="Center" /><NumberBox x:Name="RtxQualityBox" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="4" SpinButtonPlacementMode="Inline" />
                <TextBlock x:Uid="DefaultVolumeSetting" Grid.Row="3" Text="Default volume" VerticalAlignment="Center" /><NumberBox x:Name="VolumeBox" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="130" SpinButtonPlacementMode="Inline" />
                <TextBlock x:Uid="SeekIntervalSetting" Grid.Row="4" Text="Seek interval (seconds)" VerticalAlignment="Center" /><NumberBox x:Name="SeekBox" Grid.Row="4" Grid.Column="1" Minimum="1" Maximum="60" SpinButtonPlacementMode="Inline" />
                <TextBlock x:Name="RtxStatusText" Grid.Row="5" Grid.ColumnSpan="2" TextWrapping="Wrap" Opacity="0.72" Margin="0,6,0,0" />
            </Grid></Expander>
            <Expander x:Uid="PlaybackAdvancedExpander" Header="Playback languages and renderer"><Grid Padding="8" ColumnSpacing="12" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock x:Uid="RendererSetting" Text="Renderer" /><TextBox x:Name="RendererBox" Grid.Column="1" /><TextBlock x:Uid="AudioLanguageSetting" Grid.Row="1" Text="Default audio language" /><TextBox x:Name="AudioLanguageBox" Grid.Row="1" Grid.Column="1" /><TextBlock x:Uid="SubtitleLanguageSetting" Grid.Row="2" Text="Default subtitle language" /><TextBox x:Name="SubtitleLanguageBox" Grid.Row="2" Grid.Column="1" />
            </Grid></Expander>
            <Expander x:Uid="SubtitleExpander" Header="Subtitle"><Grid Padding="8" ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock x:Uid="FontSetting" Text="Font" VerticalAlignment="Center" /><TextBox x:Name="SubtitleFontBox" Grid.Column="1" />
                <TextBlock x:Uid="FontSizeSetting" Grid.Row="1" Text="Font size" VerticalAlignment="Center" /><NumberBox x:Name="SubtitleSizeBox" Grid.Row="1" Grid.Column="1" Minimum="8" Maximum="144" />
                <TextBlock x:Uid="MaxCueDurationSetting" Grid.Row="2" Text="Maximum cue duration" VerticalAlignment="Center" /><NumberBox x:Name="CueDurationBox" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="20" />
            </Grid></Expander>
            <Expander x:Uid="SubtitleAdvancedExpander" Header="Subtitle appearance and segmentation"><Grid Padding="8" ColumnSpacing="12" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock x:Uid="TextColorSetting" Text="Text color" /><TextBox x:Name="SubtitleColorBox" Grid.Column="1" /><TextBlock x:Uid="BackgroundColorSetting" Grid.Row="1" Text="Background color" /><TextBox x:Name="SubtitleBackgroundBox" Grid.Row="1" Grid.Column="1" /><TextBlock x:Uid="OutlineSetting" Grid.Row="2" Text="Outline" /><NumberBox x:Name="OutlineBox" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="10" /><TextBlock x:Uid="BottomMarginSetting" Grid.Row="3" Text="Bottom margin" /><NumberBox x:Name="BottomMarginBox" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="500" /><TextBlock x:Uid="EncodingSetting" Grid.Row="4" Text="Encoding" /><TextBox x:Name="EncodingBox" Grid.Row="4" Grid.Column="1" />
                <TextBlock x:Uid="MinCueDurationSetting" Grid.Row="5" Text="Minimum cue duration" /><NumberBox x:Name="MinCueDurationBox" Grid.Row="5" Grid.Column="1" Minimum="0.1" Maximum="10" /><TextBlock x:Uid="MaximumLinesSetting" Grid.Row="6" Text="Maximum lines" /><NumberBox x:Name="MaxLinesBox" Grid.Row="6" Grid.Column="1" Minimum="1" Maximum="5" /><TextBlock x:Uid="TargetCharactersSetting" Grid.Row="7" Text="Target characters/line" /><NumberBox x:Name="TargetCharsBox" Grid.Row="7" Grid.Column="1" Minimum="5" Maximum="100" /><TextBlock x:Uid="SilenceSplitSetting" Grid.Row="8" Text="Silence split (seconds)" /><NumberBox x:Name="SilenceSplitBox" Grid.Row="8" Grid.Column="1" Minimum="0.1" Maximum="5" />
                <TextBlock x:Uid="MaximumCpsSetting" Grid.Row="9" Text="Maximum characters/second" /><NumberBox x:Name="MaximumCpsBox" Grid.Row="9" Grid.Column="1" Minimum="1" Maximum="100" />
            </Grid></Expander>
            <Expander x:Uid="AsrExpander" Header="Automatic speech recognition"><Grid Padding="8" ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock x:Uid="AsrModelSetting" Text="Qwen3-ASR model path" VerticalAlignment="Center" /><TextBox x:Name="AsrModelBox" Grid.Column="1" />
                <TextBlock x:Uid="AlignerSetting" Grid.Row="1" Text="ForcedAligner path" VerticalAlignment="Center" /><TextBox x:Name="AlignerBox" Grid.Row="1" Grid.Column="1" />
                <TextBlock x:Uid="PythonSetting" Grid.Row="2" Text="Python executable" VerticalAlignment="Center" /><TextBox x:Name="PythonBox" Grid.Row="2" Grid.Column="1" />
                <TextBlock x:Uid="DeviceSetting" Grid.Row="3" Text="Device" VerticalAlignment="Center" /><ComboBox x:Name="AsrDeviceCombo" Grid.Row="3" Grid.Column="1" ItemsSource="{x:Bind AsrDevices}" />
                <TextBlock x:Uid="PrecisionSetting" Grid.Row="4" Text="Precision" VerticalAlignment="Center" /><ComboBox x:Name="PrecisionCombo" Grid.Row="4" Grid.Column="1" ItemsSource="{x:Bind Precisions}" />
                <CheckBox x:Uid="VadSetting" x:Name="VadCheck" Grid.Row="5" Grid.Column="1" Content="Use Silero VAD" />
            </Grid></Expander>
            <Expander x:Uid="AsrProcessingExpander" Header="ASR processing"><Grid Padding="8" ColumnSpacing="12" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock x:Uid="LanguageSetting" Text="Language" /><TextBox x:Name="AsrLanguageBox" Grid.Column="1" /><TextBlock x:Uid="ChunkDurationSetting" Grid.Row="1" Text="Chunk duration (seconds)" /><NumberBox x:Name="ChunkDurationBox" Grid.Row="1" Grid.Column="1" Minimum="5" Maximum="180" /></Grid></Expander>
            <Expander x:Uid="NetworkExpander" Header="Network"><Grid Padding="8" ColumnSpacing="12" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock x:Uid="TimeoutSetting" Text="Timeout (seconds)" /><NumberBox x:Name="NetworkTimeoutBox" Grid.Column="1" Minimum="5" Maximum="300" /><TextBlock x:Uid="ProxySetting" Grid.Row="1" Text="Proxy" /><TextBox x:Uid="ProxyInput" x:Name="ProxyBox" Grid.Row="1" Grid.Column="1" PlaceholderText="System default when empty" /></Grid></Expander>
            <Expander x:Uid="CaptureExpander" Header="Capture defaults"><Grid Padding="8" ColumnSpacing="12" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock x:Uid="CameraIdSetting" Text="Camera device id" /><TextBox x:Name="CameraIdBox" Grid.Column="1" /><TextBlock x:Uid="MicrophoneIdSetting" Grid.Row="1" Text="Microphone device id" /><TextBox x:Name="MicrophoneIdBox" Grid.Row="1" Grid.Column="1" /><TextBlock x:Uid="WidthSetting" Grid.Row="2" Text="Width" /><NumberBox x:Name="CaptureWidthBox" Grid.Row="2" Grid.Column="1" Minimum="160" Maximum="7680" /><TextBlock x:Uid="HeightSetting" Grid.Row="3" Text="Height" /><NumberBox x:Name="CaptureHeightBox" Grid.Row="3" Grid.Column="1" Minimum="120" Maximum="4320" /><TextBlock x:Uid="FrameRateSetting" Grid.Row="4" Text="Frame rate" /><NumberBox x:Name="CaptureFpsBox" Grid.Row="4" Grid.Column="1" Minimum="1" Maximum="240" />
                <TextBlock x:Uid="CaptionFontSetting" Grid.Row="5" Text="Caption font" /><TextBox x:Name="CaptionFontBox" Grid.Row="5" Grid.Column="1" /><TextBlock x:Uid="CaptionSizeSetting" Grid.Row="6" Text="Caption size" /><NumberBox x:Name="CaptionSizeBox" Grid.Row="6" Grid.Column="1" Minimum="8" Maximum="144" /><TextBlock x:Uid="CaptionTextColorSetting" Grid.Row="7" Text="Caption text color" /><TextBox x:Name="CaptionTextColorBox" Grid.Row="7" Grid.Column="1" /><TextBlock x:Uid="CaptionBackgroundSetting" Grid.Row="8" Text="Caption background" /><TextBox x:Name="CaptionBackgroundBox" Grid.Row="8" Grid.Column="1" /><TextBlock x:Uid="CaptionPositionSetting" Grid.Row="9" Text="Caption position" /><ComboBox x:Name="CaptionPositionCombo" Grid.Row="9" Grid.Column="1" ItemsSource="{x:Bind CaptionPositions}" /><TextBlock x:Uid="CaptionLinesSetting" Grid.Row="10" Text="Caption maximum lines" /><NumberBox x:Name="CaptionLinesBox" Grid.Row="10" Grid.Column="1" Minimum="1" Maximum="6" />
            </Grid></Expander>
            <Expander x:Uid="LlmExpander" Header="LLM"><Grid Padding="8" ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock x:Uid="ProviderSetting" Text="Provider" VerticalAlignment="Center" /><ComboBox x:Name="ProviderCombo" Grid.Column="1" ItemsSource="{x:Bind Providers}" SelectionChanged="OnProviderChanged" />
                <TextBlock x:Uid="ModelIdSetting" Grid.Row="1" Text="Model id" VerticalAlignment="Center" /><Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="ModelBox" /><Button x:Uid="SyncModelsButton" Grid.Column="1" Content="Sync models" Click="OnSyncModelsClick" /></Grid>
                <TextBlock x:Uid="ThinkingSetting" Grid.Row="2" Text="Thinking level" VerticalAlignment="Center" /><ComboBox x:Name="ThinkingCombo" Grid.Row="2" Grid.Column="1" ItemsSource="{x:Bind ThinkingLevels}" />
                <TextBlock x:Uid="ApiKeySetting" Grid.Row="3" Text="API key" VerticalAlignment="Center" /><Grid Grid.Row="3" Grid.Column="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><PasswordBox x:Uid="ApiKeyInput" x:Name="ApiKeyBox" PlaceholderText="Stored in Windows Credential Manager" /><Button x:Uid="ClearApiKeyButton" Grid.Column="1" Content="Clear stored key" Click="OnClearApiKeyClick" /></Grid>
                <TextBlock x:Uid="TranslationLanguageSetting" Grid.Row="4" Text="Translation language" /><TextBox x:Name="TranslationLanguageBox" Grid.Row="4" Grid.Column="1" />
            </Grid></Expander>
        </StackPanel></ScrollViewer>
        <Grid Grid.Row="1"><InfoBar x:Name="StatusBar" IsOpen="False" /><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"><Button x:Uid="CancelButton" Content="Cancel" Click="OnCancelClick" /><Button x:Uid="SaveButton" Content="Save" Style="{StaticResource AccentButtonStyle}" Click="OnSaveClick" /></StackPanel></Grid>
    </Grid>
</Window>
