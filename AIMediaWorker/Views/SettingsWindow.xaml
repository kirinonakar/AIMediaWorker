<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AIMediaWorker.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Preferences">
    <Grid x:Name="Root" Padding="24" RowSpacing="16" Loaded="OnLoaded" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="SettingsCardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MaxHeight" Value="40" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid RowSpacing="16">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TextBlock x:Uid="PreferencesTitle" Text="Preferences" Style="{StaticResource TitleTextBlockStyle}" Margin="4,0,0,0" />
            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Padding="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                    <ListView x:Name="SettingsSectionList" SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Height" Value="48" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0,2" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListViewItem><TextBlock x:Uid="SettingsGeneralSection" Text="General" Padding="10,8" /></ListViewItem>
                        <ListViewItem><TextBlock x:Uid="SettingsAssociationsSection" Text="File associations" Padding="10,8" TextWrapping="Wrap" /></ListViewItem>
                        <ListViewItem><TextBlock x:Uid="SettingsPlaybackSection" Text="Playback" Padding="10,8" /></ListViewItem>
                        <ListViewItem><TextBlock x:Uid="SettingsSubtitleSection" Text="Subtitle" Padding="10,8" /></ListViewItem>
                        <ListViewItem><TextBlock x:Uid="SettingsAsrSection" Text="Speech recognition" Padding="10,8" TextWrapping="Wrap" /></ListViewItem>
                        <ListViewItem><TextBlock x:Uid="SettingsNetworkSection" Text="Network" Padding="10,8" /></ListViewItem>
                        <ListViewItem><TextBlock x:Uid="SettingsCaptureSection" Text="Capture" Padding="10,8" /></ListViewItem>
                        <ListViewItem><TextBlock x:Uid="SettingsAiSection" Text="AI" Padding="10,8" /></ListViewItem>
                    </ListView>
                </Border>
                <Grid Grid.Column="1">
                <ScrollViewer x:Name="GeneralSection"><StackPanel Spacing="16" Padding="0,0,12,12">
            <Border Style="{StaticResource SettingsCardStyle}"><StackPanel><TextBlock Text="{x:Bind GeneralHeading}" Style="{StaticResource SettingsCardTitleStyle}" /><Grid ColumnSpacing="20" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
<Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="40" /><RowDefinition Height="40" /><RowDefinition Height="40" /><RowDefinition Height="40" /><RowDefinition Height="40" /><RowDefinition Height="40" /></Grid.RowDefinitions>
                <TextBlock x:Uid="LanguageSetting" Text="Language" VerticalAlignment="Center" /><ComboBox x:Name="LanguageCombo" Grid.Column="1" ItemsSource="{x:Bind Languages}" />
                <TextBlock x:Uid="ThemeSetting" Grid.Row="1" Text="Theme" VerticalAlignment="Center" /><ComboBox x:Name="ThemeCombo" Grid.Row="1" Grid.Column="1" ItemsSource="{x:Bind Themes}" />
                <TextBlock x:Uid="UiFontSetting" Grid.Row="2" Text="UI font" VerticalAlignment="Center" /><DropDownButton x:Name="UiFontButton" Grid.Row="2" Grid.Column="1" Height="40" MinHeight="40" MaxHeight="40" MinWidth="280" VerticalAlignment="Center" HorizontalContentAlignment="Left"><DropDownButton.Flyout><Flyout x:Name="UiFontFlyout" Placement="BottomEdgeAlignedLeft" Opening="OnFontFlyoutOpening"><Grid Width="320" Height="300" MinHeight="300" MaxHeight="300"><ProgressRing x:Name="UiFontProgress" IsActive="True" HorizontalAlignment="Center" VerticalAlignment="Center" /><ListView x:Name="UiFontList" Height="300" MinHeight="300" MaxHeight="300" Visibility="Collapsed" SelectionChanged="OnFontListSelectionChanged" /></Grid></Flyout></DropDownButton.Flyout></DropDownButton>
                <TextBlock x:Uid="RecentItemsSetting" Grid.Row="3" Text="Recent items" VerticalAlignment="Center" /><NumberBox x:Name="RecentCountBox" Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="20" SpinButtonPlacementMode="Inline" />
                <CheckBox x:Uid="ResumeSetting" x:Name="ResumeCheck" Grid.Row="4" Grid.Column="1" Content="Resume playback position" />
                <TextBlock x:Uid="DefaultFolderSetting" Grid.Row="5" Text="Default folder" VerticalAlignment="Center" /><Grid Grid.Row="5" Grid.Column="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button x:Uid="BrowseDefaultFolderButton" Grid.Column="1" Content="Browse…" Click="OnBrowseDefaultFolderClick" /><Button x:Uid="ClearDefaultFolderButton" Grid.Column="2" Content="Clear" Click="OnClearDefaultFolderClick" /></Grid><TextBox x:Uid="DefaultFolderBox" x:Name="DefaultFolderBox" Grid.Row="6" Grid.ColumnSpan="2" PlaceholderText="No default folder — opens Videos on startup" />
            </Grid></StackPanel></Border>
                </StackPanel></ScrollViewer>
                <ScrollViewer x:Name="AssociationsSection" Visibility="Collapsed"><StackPanel Spacing="16" Padding="0,0,12,12">
            <Border Style="{StaticResource SettingsCardStyle}"><StackPanel Spacing="14">
                <TextBlock x:Uid="FileAssociationsHeading" Text="File associations" Style="{StaticResource SettingsCardTitleStyle}" Margin="0" />
                <TextBlock x:Uid="FileAssociationsDescription" Text="Register AIMediaWorker with Windows, then choose the default app for each media extension. Registration also adds AIMediaWorker to Open with." TextWrapping="Wrap" Opacity="0.78" />
                <ItemsControl x:Name="AssociationOptionsList" ItemsSource="{x:Bind AssociationOptions}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Extension}" IsChecked="{Binding IsSelected, Mode=TwoWay}" MinWidth="92" Margin="0,2,12,2" /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="AssociationStateText" TextWrapping="Wrap" Opacity="0.78" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="RegisterAssociationsButton" x:Name="RegisterAssociationsButton" Content="Register with Windows" Click="OnRegisterAssociationsClick" />
                    <Button x:Uid="UnregisterAndUnloadButton" x:Name="UnregisterAndUnloadButton" Content="Unregister and unload DLLs" Click="OnUnregisterAndUnloadClick" />
                    <Button x:Uid="OpenDefaultAppsButton" Content="Open Windows default apps" Style="{StaticResource AccentButtonStyle}" Click="OnOpenDefaultAppsClick" />
                </StackPanel>
            </StackPanel></Border>
                </StackPanel></ScrollViewer>
                <ScrollViewer x:Name="PlaybackSection" Visibility="Collapsed"><StackPanel Spacing="16" Padding="0,0,12,12">
            <Border Style="{StaticResource SettingsCardStyle}"><StackPanel><TextBlock Text="{x:Bind PlaybackHeading}" Style="{StaticResource SettingsCardTitleStyle}" /><Grid ColumnSpacing="20" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock x:Uid="HardwareDecoderSetting" Text="Hardware decoder" VerticalAlignment="Center" /><ComboBox x:Name="HardwareCombo" Grid.Column="1" ItemsSource="{x:Bind HardwareDecoders}" />
                <TextBlock x:Uid="RtxSetting" Grid.Row="1" Text="RTX Video Super Resolution" VerticalAlignment="Center" /><ComboBox x:Name="RtxCombo" Grid.Row="1" Grid.Column="1" ItemsSource="{x:Bind RtxModes}" />
                <TextBlock x:Uid="DefaultVolumeSetting" Grid.Row="2" Text="Default volume" VerticalAlignment="Center" /><NumberBox x:Name="VolumeBox" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="130" SpinButtonPlacementMode="Inline" />
                <TextBlock x:Uid="SeekIntervalSetting" Grid.Row="3" Text="Seek interval (seconds)" VerticalAlignment="Center" /><NumberBox x:Name="SeekBox" Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="60" SpinButtonPlacementMode="Inline" />
                <TextBlock x:Name="RtxStatusText" Grid.Row="4" Grid.ColumnSpan="2" TextWrapping="Wrap" Opacity="0.72" Margin="0,6,0,0" />
            </Grid></StackPanel></Border>
            <Border Style="{StaticResource SettingsCardStyle}"><StackPanel><TextBlock Text="{x:Bind PlaybackAdvancedHeading}" Style="{StaticResource SettingsCardTitleStyle}" /><Grid ColumnSpacing="20" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock x:Uid="RendererSetting" Text="Renderer" /><TextBox x:Name="RendererBox" Grid.Column="1" /><TextBlock x:Uid="AudioLanguageSetting" Grid.Row="1" Text="Default audio language" /><TextBox x:Name="AudioLanguageBox" Grid.Row="1" Grid.Column="1" /><TextBlock x:Uid="SubtitleLanguageSetting" Grid.Row="2" Text="Default subtitle language" /><TextBox x:Name="SubtitleLanguageBox" Grid.Row="2" Grid.Column="1" />
            </Grid></StackPanel></Border>
                </StackPanel></ScrollViewer>
                <ScrollViewer x:Name="SubtitleSection" Visibility="Collapsed"><StackPanel Spacing="16" Padding="0,0,12,12">
            <Border Style="{StaticResource SettingsCardStyle}"><StackPanel><TextBlock Text="{x:Bind SubtitleHeading}" Style="{StaticResource SettingsCardTitleStyle}" /><Grid ColumnSpacing="20" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="40" /><RowDefinition Height="40" /></Grid.RowDefinitions>
                <TextBlock x:Uid="FontSetting" Text="Font" VerticalAlignment="Center" /><DropDownButton x:Name="SubtitleFontButton" Grid.Column="1" Height="40" MinHeight="40" MaxHeight="40" MinWidth="280" VerticalAlignment="Center" HorizontalContentAlignment="Left"><DropDownButton.Flyout><Flyout x:Name="SubtitleFontFlyout" Placement="BottomEdgeAlignedLeft" Opening="OnFontFlyoutOpening"><Grid Width="320" Height="300" MinHeight="300" MaxHeight="300"><ProgressRing x:Name="SubtitleFontProgress" IsActive="True" HorizontalAlignment="Center" VerticalAlignment="Center" /><ListView x:Name="SubtitleFontList" Height="300" MinHeight="300" MaxHeight="300" Visibility="Collapsed" SelectionChanged="OnFontListSelectionChanged" /></Grid></Flyout></DropDownButton.Flyout></DropDownButton>
                <TextBlock x:Uid="FontSizeSetting" Grid.Row="1" Text="Font size" VerticalAlignment="Center" /><NumberBox x:Name="SubtitleSizeBox" Grid.Row="1" Grid.Column="1" Minimum="8" Maximum="144" />
                <TextBlock x:Uid="MaxCueDurationSetting" Grid.Row="2" Text="Maximum cue duration" VerticalAlignment="Center" /><NumberBox x:Name="CueDurationBox" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="20" />
            </Grid></StackPanel></Border>
            <Border Style="{StaticResource SettingsCardStyle}"><StackPanel><TextBlock Text="{x:Bind SubtitleAdvancedHeading}" Style="{StaticResource SettingsCardTitleStyle}" /><Grid ColumnSpacing="20" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock x:Uid="TextColorSetting" Text="Text color" VerticalAlignment="Center" /><Button x:Name="SubtitleColorButton" Grid.Column="1" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,0"><Button.Flyout><Flyout Placement="BottomEdgeAlignedLeft"><ColorPicker x:Name="SubtitleColorPicker" Width="320" IsAlphaEnabled="True" IsMoreButtonVisible="False" ColorChanged="OnColorPickerChanged" /></Flyout></Button.Flyout><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="SubtitleColorPreview" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" /><TextBlock x:Name="SubtitleColorValue" Grid.Column="1" VerticalAlignment="Center" FontFamily="Consolas" /></Grid></Button>
                <TextBlock x:Uid="BackgroundColorSetting" Grid.Row="1" Text="Background color" VerticalAlignment="Center" /><Button x:Name="SubtitleBackgroundButton" Grid.Row="1" Grid.Column="1" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,0"><Button.Flyout><Flyout Placement="BottomEdgeAlignedLeft"><ColorPicker x:Name="SubtitleBackgroundPicker" Width="320" IsAlphaEnabled="True" IsMoreButtonVisible="False" ColorChanged="OnColorPickerChanged" /></Flyout></Button.Flyout><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="SubtitleBackgroundPreview" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" /><TextBlock x:Name="SubtitleBackgroundValue" Grid.Column="1" VerticalAlignment="Center" FontFamily="Consolas" /></Grid></Button>
                <TextBlock x:Uid="OutlineSetting" Grid.Row="2" Text="Outline" /><NumberBox x:Name="OutlineBox" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="10" /><TextBlock x:Uid="BottomMarginSetting" Grid.Row="3" Text="Bottom margin" /><NumberBox x:Name="BottomMarginBox" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="500" /><TextBlock x:Uid="EncodingSetting" Grid.Row="4" Text="Encoding" /><TextBox x:Name="EncodingBox" Grid.Row="4" Grid.Column="1" />
                <TextBlock x:Uid="MinCueDurationSetting" Grid.Row="5" Text="Minimum cue duration" /><NumberBox x:Name="MinCueDurationBox" Grid.Row="5" Grid.Column="1" Minimum="0.1" Maximum="10" /><TextBlock x:Uid="MaximumLinesSetting" Grid.Row="6" Text="Maximum lines" /><NumberBox x:Name="MaxLinesBox" Grid.Row="6" Grid.Column="1" Minimum="1" Maximum="5" /><TextBlock x:Uid="TargetCharactersSetting" Grid.Row="7" Text="Target characters/line" /><NumberBox x:Name="TargetCharsBox" Grid.Row="7" Grid.Column="1" Minimum="5" Maximum="100" /><TextBlock x:Uid="SilenceSplitSetting" Grid.Row="8" Text="Silence split (seconds)" /><NumberBox x:Name="SilenceSplitBox" Grid.Row="8" Grid.Column="1" Minimum="0.1" Maximum="5" />
                <TextBlock x:Uid="MaximumCpsSetting" Grid.Row="9" Text="Maximum characters/second" /><NumberBox x:Name="MaximumCpsBox" Grid.Row="9" Grid.Column="1" Minimum="1" Maximum="100" />
            </Grid></StackPanel></Border>
                </StackPanel></ScrollViewer>
                <ScrollViewer x:Name="AsrSection" Visibility="Collapsed"><StackPanel Spacing="16" Padding="0,0,12,12">
            <Border Style="{StaticResource SettingsCardStyle}"><StackPanel><TextBlock Text="{x:Bind AsrHeading}" Style="{StaticResource SettingsCardTitleStyle}" /><Grid ColumnSpacing="20" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock x:Uid="AsrModelSetting" Text="Qwen3-ASR model" VerticalAlignment="Center" /><TextBox x:Name="AsrModelBox" Grid.Column="1" IsReadOnly="True" />
                <TextBlock x:Uid="AlignerSetting" Grid.Row="1" Text="ForcedAligner model" VerticalAlignment="Center" /><TextBox x:Name="AlignerBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" />
                <TextBlock x:Uid="CrispAsrRuntimeSetting" Grid.Row="2" Text="CrispASR runtime" VerticalAlignment="Center" /><TextBox x:Name="CrispAsrRuntimeBox" Grid.Row="2" Grid.Column="1" IsReadOnly="True" />
                <TextBlock x:Uid="DeviceSetting" Grid.Row="3" Text="Device" VerticalAlignment="Center" /><ComboBox x:Name="AsrDeviceCombo" Grid.Row="3" Grid.Column="1" ItemsSource="{x:Bind AsrDevices}" />
                <TextBlock x:Uid="PrecisionSetting" Grid.Row="4" Text="Precision" VerticalAlignment="Center" /><ComboBox x:Name="PrecisionCombo" Grid.Row="4" Grid.Column="1" ItemsSource="{x:Bind Precisions}" />
                <CheckBox x:Uid="VadSetting" x:Name="VadCheck" Grid.Row="5" Grid.Column="1" Content="Use Silero VAD" />
            </Grid></StackPanel></Border>
            <Border Style="{StaticResource SettingsCardStyle}"><StackPanel Spacing="10">
                <TextBlock x:Uid="AsrInstallationHeading" Text="ASR installation" Style="{StaticResource SettingsCardTitleStyle}" Margin="0" />
                <TextBlock x:Uid="AsrInstallationDescription" Text="Checks the native runtimes and downloads the GGUF models below the executable." TextWrapping="Wrap" Opacity="0.78" />
                <TextBox x:Name="AsrModelFolderBox" IsReadOnly="True" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Uid="InstallAsrButton" x:Name="InstallAsrButton" Content="Install" Style="{StaticResource AccentButtonStyle}" Click="OnInstallAsrClick" />
                    <TextBlock x:Name="AsrInstallStatusText" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                <ProgressBar x:Name="AsrInstallProgressBar" Minimum="0" Maximum="100" Visibility="Collapsed" />
            </StackPanel></Border>
            <Border Style="{StaticResource SettingsCardStyle}"><StackPanel><TextBlock Text="{x:Bind AsrProcessingHeading}" Style="{StaticResource SettingsCardTitleStyle}" /><Grid ColumnSpacing="20" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock x:Uid="LanguageSetting" Text="Language" VerticalAlignment="Center" /><TextBox x:Name="AsrLanguageBox" Grid.Column="1" /><TextBlock x:Uid="ChunkDurationSetting" Grid.Row="1" Text="Chunk duration (seconds)" VerticalAlignment="Center" /><NumberBox x:Name="ChunkDurationBox" Grid.Row="1" Grid.Column="1" Minimum="5" Maximum="180" /></Grid></StackPanel></Border>
                </StackPanel></ScrollViewer>
                <ScrollViewer x:Name="NetworkSection" Visibility="Collapsed"><StackPanel Spacing="16" Padding="0,0,12,12">
            <Border Style="{StaticResource SettingsCardStyle}"><StackPanel><TextBlock Text="{x:Bind NetworkHeading}" Style="{StaticResource SettingsCardTitleStyle}" /><Grid ColumnSpacing="20" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock x:Uid="TimeoutSetting" Text="Timeout (seconds)" VerticalAlignment="Center" /><NumberBox x:Name="NetworkTimeoutBox" Grid.Column="1" Minimum="5" Maximum="300" /><TextBlock x:Uid="ProxySetting" Grid.Row="1" Text="Proxy" VerticalAlignment="Center" /><TextBox x:Uid="ProxyInput" x:Name="ProxyBox" Grid.Row="1" Grid.Column="1" PlaceholderText="System default when empty" /></Grid></StackPanel></Border>
                </StackPanel></ScrollViewer>
                <ScrollViewer x:Name="CaptureSection" Visibility="Collapsed"><StackPanel Spacing="16" Padding="0,0,12,12">
            <Border Style="{StaticResource SettingsCardStyle}"><StackPanel><TextBlock Text="{x:Bind CaptureHeading}" Style="{StaticResource SettingsCardTitleStyle}" /><Grid ColumnSpacing="20" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock x:Uid="CameraIdSetting" Text="Camera device id" VerticalAlignment="Center" /><TextBox x:Name="CameraIdBox" Grid.Column="1" /><TextBlock x:Uid="MicrophoneIdSetting" Grid.Row="1" Text="Microphone device id" VerticalAlignment="Center" /><TextBox x:Name="MicrophoneIdBox" Grid.Row="1" Grid.Column="1" /><TextBlock x:Uid="WidthSetting" Grid.Row="2" Text="Width" VerticalAlignment="Center" /><NumberBox x:Name="CaptureWidthBox" Grid.Row="2" Grid.Column="1" Minimum="160" Maximum="7680" /><TextBlock x:Uid="HeightSetting" Grid.Row="3" Text="Height" VerticalAlignment="Center" /><NumberBox x:Name="CaptureHeightBox" Grid.Row="3" Grid.Column="1" Minimum="120" Maximum="4320" /><TextBlock x:Uid="FrameRateSetting" Grid.Row="4" Text="Frame rate" VerticalAlignment="Center" /><NumberBox x:Name="CaptureFpsBox" Grid.Row="4" Grid.Column="1" Minimum="1" Maximum="240" />
                 <TextBlock x:Uid="CaptionSizeSetting" Grid.Row="5" Text="Caption size" /><NumberBox x:Name="CaptionSizeBox" Grid.Row="5" Grid.Column="1" Minimum="8" Maximum="144" /><TextBlock x:Uid="CaptionTextColorSetting" Grid.Row="6" Text="Caption text color" VerticalAlignment="Center" /><Button x:Name="CaptionTextColorButton" Grid.Row="6" Grid.Column="1" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,0"><Button.Flyout><Flyout Placement="BottomEdgeAlignedLeft"><ColorPicker x:Name="CaptionTextColorPicker" Width="320" IsAlphaEnabled="True" IsMoreButtonVisible="False" ColorChanged="OnColorPickerChanged" /></Flyout></Button.Flyout><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="CaptionTextColorPreview" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" /><TextBlock x:Name="CaptionTextColorValue" Grid.Column="1" VerticalAlignment="Center" FontFamily="Consolas" /></Grid></Button><TextBlock x:Uid="CaptionBackgroundSetting" Grid.Row="7" Text="Caption background" VerticalAlignment="Center" /><Button x:Name="CaptionBackgroundButton" Grid.Row="7" Grid.Column="1" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,0"><Button.Flyout><Flyout Placement="BottomEdgeAlignedLeft"><ColorPicker x:Name="CaptionBackgroundPicker" Width="320" IsAlphaEnabled="True" IsMoreButtonVisible="False" ColorChanged="OnColorPickerChanged" /></Flyout></Button.Flyout><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="CaptionBackgroundPreview" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" /><TextBlock x:Name="CaptionBackgroundValue" Grid.Column="1" VerticalAlignment="Center" FontFamily="Consolas" /></Grid></Button><TextBlock x:Uid="CaptionPositionSetting" Grid.Row="8" Text="Caption position" /><ComboBox x:Name="CaptionPositionCombo" Grid.Row="8" Grid.Column="1" ItemsSource="{x:Bind CaptionPositions}" /><TextBlock x:Uid="CaptionLinesSetting" Grid.Row="9" Text="Caption maximum lines" /><NumberBox x:Name="CaptionLinesBox" Grid.Row="9" Grid.Column="1" Minimum="1" Maximum="6" />
            </Grid></StackPanel></Border>
                </StackPanel></ScrollViewer>
                <ScrollViewer x:Name="LlmSection" Visibility="Collapsed"><StackPanel Spacing="16" Padding="0,0,12,12">
            <Border Style="{StaticResource SettingsCardStyle}"><StackPanel><TextBlock Text="{x:Bind LlmHeading}" Style="{StaticResource SettingsCardTitleStyle}" /><Grid ColumnSpacing="20" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock x:Uid="ProviderSetting" Text="Provider" VerticalAlignment="Center" /><ComboBox x:Name="ProviderCombo" Grid.Column="1" ItemsSource="{x:Bind Providers}" SelectionChanged="OnProviderChanged" />
                <TextBlock x:Uid="ModelIdSetting" Grid.Row="1" Text="Model id" VerticalAlignment="Center" /><Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="ModelBox" /><Button x:Uid="SyncModelsButton" Grid.Column="1" Content="Sync models" Click="OnSyncModelsClick" /></Grid>
                <TextBlock x:Uid="ThinkingSetting" Grid.Row="2" Text="Thinking level" VerticalAlignment="Center" /><ComboBox x:Name="ThinkingCombo" Grid.Row="2" Grid.Column="1" ItemsSource="{x:Bind ThinkingLevels}" />
                <TextBlock x:Uid="ApiKeySetting" Grid.Row="3" Text="API key" VerticalAlignment="Center" /><Grid Grid.Row="3" Grid.Column="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><PasswordBox x:Uid="ApiKeyInput" x:Name="ApiKeyBox" PlaceholderText="Stored in Windows Credential Manager" /><Button x:Uid="ClearApiKeyButton" Grid.Column="1" Content="Clear stored key" Click="OnClearApiKeyClick" /></Grid>
                <TextBlock x:Uid="TranslationLanguageSetting" Grid.Row="4" Text="Translation language" /><TextBox x:Name="TranslationLanguageBox" Grid.Row="4" Grid.Column="1" />
            </Grid></StackPanel></Border>
                </StackPanel></ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
        <Grid Grid.Row="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <InfoBar x:Name="StatusBar" IsOpen="False" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Uid="CancelButton" Content="Cancel" Click="OnCancelClick" />
                <Button x:Uid="SaveButton" Content="Save" Style="{StaticResource AccentButtonStyle}" Click="OnSaveClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
