<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AIMediaWorker.Views.WebDavWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WebDAV browser">
    <Grid x:Name="Root" Padding="12" ColumnSpacing="12" RowSpacing="8" Loaded="OnLoaded">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Uid="ServersLabel" Text="Servers" Style="{StaticResource SubtitleTextBlockStyle}" />
        <CommandBar Grid.Column="1" DefaultLabelPosition="Right">
            <AppBarButton x:Uid="ParentButton" Icon="Back" Label="Parent" Click="OnParentClick" />
            <AppBarButton x:Uid="RefreshCommand" Icon="Refresh" Label="Refresh" Click="OnRefreshClick" />
            <AppBarButton x:Uid="FavoriteFolderCommand" Icon="Favorite" Label="Favorite folder" Click="OnFavoriteFolderClick" />
            <AppBarButton x:Uid="OpenCommand" Icon="OpenFile" Label="Open" Click="OnOpenClick" />
        </CommandBar>

        <Grid Grid.Row="1" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListView x:Name="ServerList" DisplayMemberPath="Name" SelectionChanged="OnServerChanged" />
            <CommandBar Grid.Row="1" DefaultLabelPosition="Right" IsOpen="True">
                <AppBarButton x:Uid="AddCommand" Icon="Add" Label="Add" Click="OnAddServerClick" />
                <AppBarButton x:Uid="EditCommand" Icon="Edit" Label="Edit" Click="OnEditServerClick" />
                <AppBarButton x:Uid="DeleteCommand" Icon="Delete" Label="Delete" Click="OnDeleteServerClick" />
            </CommandBar>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="PathText" Text="Select a server to browse files and folders" TextTrimming="CharacterEllipsis" Opacity="0.72" Margin="4" />
            <ListView x:Name="EntryList" Grid.Row="1" IsItemClickEnabled="True" ItemClick="OnEntryClick" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="6" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{Binding IconGlyph}" FontSize="18" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ContentType}" FontSize="11" Opacity="0.6" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" Opacity="0.65" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <InfoBar x:Uid="WebDavInitialStatus" x:Name="StatusBar" Grid.Row="2" Grid.ColumnSpan="2" IsOpen="True" Severity="Informational" Title="WebDAV" Message="Add or select a server." />
    </Grid>
</Window>
